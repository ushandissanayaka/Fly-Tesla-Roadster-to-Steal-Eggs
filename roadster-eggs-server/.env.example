PORT=2567

# Slug the game is registered under on bloxity.io
GAME_SLUG=roadster-eggs

# Bloxity REST API (only change for staging)
BLOXITY_API_URL=https://api.bloxity.io

# Shared secret Bloxity sends in the x-legion-webhook-secret header on Gems purchases
LEGION_WEBHOOK_SECRET=

# Injected automatically by Bloxity hosting. Leave empty locally: stat reporting is skipped.
BLOXITY_REPORT_TOKEN=
BLOXITY_GAME_ID=

# Saves + Gems grants. Set MONGODB_URI on hosting; empty = JSON files in DATA_DIR (local dev).
MONGODB_URI=
DATA_DIR=./data

# Players per room
SEAT_CAP=20

# Comma-separated origins allowed to call the HTTP API (empty = allow all)
CORS_ORIGINS=
